# Postgres connection string (Supabase-compatible)
DATABASE_URL=
# API port (optional, default 4000)
PORT=4000
# Anthropic API key for the Opus codegen engine (Phase 2)
ANTHROPIC_API_KEY=

# Gemini (alternative codegen engine)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# DEFAULT_ENGINE=opus   # or "gemini"

# Qoder (CLI agent engine) — uses your `qoder login` session; no key needed here
# QODER_BIN=~/.qoder/entry/qoder
# QODER_MODEL=Qwen3.8-Flash
# QODER_PERMISSION_MODE=accept_edits

# OpenAI (GPT) engine
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
